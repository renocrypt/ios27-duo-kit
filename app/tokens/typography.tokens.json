{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "sans-serif"
        ],
        "$description": "SF Pro through the system font on macOS Chrome; optical size switches automatically"
      },
      "rounded": {
        "$type": "fontFamily",
        "$value": [
          "ui-rounded",
          "SF Pro Rounded",
          "system-ui",
          "sans-serif"
        ],
        "$description": "SF Pro Rounded. Chrome exposes neither ui-rounded nor an installed SF Pro Rounded (Chrome 154, 2026-09-23); on the dev server tools/vite-plugin-fonts.ts serves it from this Mac's font folders. Production falls back to the system font"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "ui-serif",
          "New York",
          "serif"
        ],
        "$description": "New York. macOS keeps it as a hidden system font and Chrome 154 does not expose ui-serif; on the dev server tools/vite-plugin-fonts.ts serves it. Production falls back to serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ],
        "$description": "SF Mono. Hidden system font on macOS; on the dev server tools/vite-plugin-fonts.ts serves it. Production falls back to Menlo"
      }
    }
  },
  "text": {
